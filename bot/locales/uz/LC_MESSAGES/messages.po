msgstr "❌ Yuborish bekor qilindi."

msgid "This form is no longer active."
msgstr "Bu shakl endi faol emas."

msgid "Please use the buttons under your submission: ✅ Send or 🔄 Start over."
msgstr "Iltimos, ariza ostidagi tugmalardan foydalaning: ✅ Yuborish yoki 🔄 Qaytadan boshlash."

msgid "Please use the buttons below 👇"
msgstr "Iltimos, quyidagi tugmalardan foydalaning 👇"

