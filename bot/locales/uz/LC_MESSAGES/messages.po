#, python-brace-format
msgid ""
"❌ <b>Rejecting {name}</b>\n"
"\n"
"Send the reason as one message. Accepted formats:\n"
"• text\n"
"• photo (optionally with a caption)\n"
"• file/document (optionally with a caption)\n"
"• voice message recorded in Telegram\n"
"\n"
"The client will receive it without your name or profile."
msgstr ""
"❌ <b>Rad etish: {name}</b>\n"
"\n"
"Sababni bitta xabar bilan yuboring. Qabul qilinadigan formatlar:\n"
"• matn\n"
"• rasm (izoh bilan bo'lishi mumkin)\n"
"• fayl/hujjat (izoh bilan bo'lishi mumkin)\n"
"• Telegramda yozilgan ovozli xabar\n"
"\n"
"Mijoz uni sizning ismingiz va profilingizsiz oladi."

msgid "⚠️ This format is not accepted. Please send text, a photo, a file or a voice message."
msgstr "⚠️ Bu format qabul qilinmaydi. Matn, rasm, fayl yoki ovozli xabar yuboring."

#, python-brace-format
msgid ""
"✅ <b>{name}</b> approved.\n"
"\n"
"The link has been sent to the user. For safety, here is a copy you can forward if needed:\n"
"{link}"
msgstr ""
"✅ <b>{name}</b>: tasdiqlandi.\n"
"\n"
"Havola foydalanuvchiga yuborildi. Ehtiyot uchun, kerak bo'lsa yuborishingiz mumkin bo'lgan nusxa:"
"\n"
"{link}"

#, python-brace-format
