"✅ <b>{name}</b> approved, but the link could NOT be delivered.\n"
"\n"
"Reason: {error}\n"
"\n"
"Link:\n"
"{link}"
msgstr ""
"✅ <b>{name}</b>: tasdiqlandi, lekin havolani yetkazib BO'LMADI.\n"
"\n"
"Sababi: {error}\n"
"\n"
"Havola:\n"
"{link}"

#, python-brace-format
msgid ""
"⚠️ Bot setup problem: {problem}.\n"
"Add the bot to the channel as an administrator with the “Invite users via link” right."
msgstr ""
"⚠️ Bot sozlamasida muammo: {problem}.\n"
"Botni kanalga «Havola orqali taklif qilish» huquqi bilan administrator qilib qo'shing."

msgid "✅ A new link was created for this client.\n\nIt has NOT been sent yet — press “📤 Resend link to user” to send it."
msgstr "✅ Bu mijoz uchun yangi havola yaratildi.\n\nU hali YUBORILMAGAN — yuborish uchun “📤 Havolani qayta yuborish” tugmasini bosing."

msgid "✅ The new link has been sent to the client."
msgstr "✅ Yangi havola mijozga yuborildi."

msgid "⚠️ The link could not be sent to the client."
msgstr "⚠️ Havolani mijozga yuborib bo'lmadi."

msgid ""
"🔗 The admin has sent you a new link to join the private channel “{channel}”.\n"
"\n"
"It works only for your Telegram account and is valid until {expires}. The previous link no longer works:\n"
"<pre>{link}</pre>\n"
"Open it and tap “Request to join” — the bot will let you in automatically."
msgstr ""
"🔗 Administrator sizga yopiq “{channel}” kanaliga qo'shilish uchun yangi havola yubordi.\n"
"\n"
"U faqat sizning Telegram akkauntingiz uchun ishlaydi va {expires} gacha amal qiladi. Oldingi havola endi ishlamaydi:\n"
"<pre>{link}</pre>\n"
"Uni oching va «Qo'shilish so'rovi»ni bosing — bot sizni avtomatik qabul qiladi."

msgid "private"
msgstr "yopiq"
