#, python-brace-format
msgid "🎉 {name} joined the channel"
msgstr "🎉 {name} kanalga qo'shildi"

msgid "👋 Welcome, admin!"
msgstr "👋 Xush kelibsiz, administrator!"

msgid "👋 Welcome! Use the buttons below to submit your payment or change the language."
msgstr "👋 Xush kelibsiz! To'lovni yuborish yoki tilni o'zgartirish uchun quyidagi tugmalardan foydalaning."

msgid "✅ Language changed."
msgstr "✅ Til o'zgartirildi."

msgid "👋 Welcome! Here you can submit your payment to get access to the channel."
msgstr "👋 Xush kelibsiz! Bu yerda kanalga kirish uchun to'lovingizni tasdiqlab yuborishingiz mumkin."

msgid "⏳ Your payment has not been approved yet. Please wait — we'll notify you here."
msgstr "⏳ To'lovingiz hali tasdiqlanmadi. Iltimos, kuting — sizga shu yerda xabar beramiz."

#, python-brace-format
msgid "⚠️ Could not create the invite link: {error}"
msgstr "⚠️ Taklif havolasini yaratib bo'lmadi: {error}"

msgid "There is no active link. Generate a new one first."
msgstr "Faol havola yo'q. Avval yangisini yarating."

msgid "📤 The link was sent to the user."
msgstr "📤 Havola foydalanuvchiga yuborildi."

#, python-brace-format
msgid "⚠️ Could not send the link: {error}"
msgstr "⚠️ Havolani yuborib bo'lmadi: {error}"

#, python-brace-format
msgid "ℹ️ Already processed by {admin}."
msgstr "ℹ️ Allaqachon ko'rib chiqilgan: {admin}."

msgid "Client not found."
msgstr "Mijoz topilmadi."

msgid ""
"❌ Unfortunately, your payment was not accepted.\n"
"\n"
"Reason:"
msgstr ""
"❌ Afsuski, to'lovingiz qabul qilinmadi.\n"
"\n"
"Sababi:"

#, python-brace-format
msgid "✅ The reason was delivered to {name}."
msgstr "✅ Sabab yetkazildi: {name}."

#, python-brace-format
msgid "⚠️ Could not deliver the reason to {name}: {error}"
msgstr "⚠️ Sababni yetkazib bo'lmadi ({name}): {error}"

#, python-brace-format
msgid "❌ {name} rejected."
msgstr "❌ {name}: rad etildi."

msgid "⏳ Your payment is under review. We'll notify you here once it's checked."
msgstr "⏳ To'lovingiz tekshirilmoqda. Tekshirib bo'lgach, sizga shu yerda xabar beramiz."

msgid "✅ You're already approved. Please use the personal invite link we sent you."
msgstr "✅ To'lovingiz allaqachon tasdiqlangan. Sizga yuborilgan shaxsiy havoladan foydalaning."

#, python-brace-format
msgid "Need help? Contact @{support}"
msgstr "Yordam kerakmi? @{support} ga yozing"

msgid ""
"💳 <b>How to pay</b>\n"
"\n"
"1. Open the payment page below and pay by card transfer.\n"
"2. Take a screenshot of the successful payment.\n"
"3. Send the screenshot or receipt (photo, image file or PDF) here 👇"
msgstr ""
"💳 <b>Qanday to'lash kerak</b>\n"
"\n"
"1. Quyidagi to'lov sahifasini oching va kartaga o'tkazma orqali to'lang.\n"
"2. Muvaffaqiyatli to'lov skrinshotini oling.\n"
"3. Skrinshot yoki chekni (rasm, rasm-fayl yoki PDF) shu yerga yuboring 👇"

msgid "🌐 Choose your language:"
msgstr "🌐 Tilni tanlang:"

msgid "⚠️ Please send the payment screenshot or receipt as a photo, an image file or a PDF."
msgstr "⚠️ Iltimos, to'lov skrinshoti yoki chekini rasm, rasm-fayl yoki PDF sifatida yuboring."

msgid "✍️ Enter your full name (first and last name):"
msgstr "✍️ To'liq ismingizni kiriting (ism va familiya):"

msgid "⚠️ The name must be 2 to 100 characters long. Please try again:"
msgstr "⚠️ Ism 2 dan 100 tagacha belgidan iborat bo'lishi kerak. Qaytadan urinib ko'ring:"

msgid "⚠️ Please type your full name as text."
msgstr "⚠️ Iltimos, to'liq ismingizni matn ko'rinishida yozing."

msgid "📞 Send your phone number: tap “Share my contact” below, or type it, e.g. +998 90 123 45 67"
msgstr ""
"📞 Telefon raqamingizni yuboring: quyidagi «Kontaktni ulashish» tugmasini bosing yoki yozing, "
"masalan +998 90 123 45 67"

msgid "Or use the number from your previous attempt:"
msgstr "Yoki oldingi urinishdagi raqamdan foydalaning:"

msgid "⚠️ Please share your own contact using the button, or type your number."
msgstr "⚠️ Iltimos, tugma orqali o'z kontaktingizni ulashing yoki raqamni yozing."

msgid "⚠️ Only Uzbekistan numbers are accepted. Please type a number like +998 90 123 45 67"
msgstr "⚠️ Faqat O'zbekiston raqamlari qabul qilinadi. Raqamni +998 90 123 45 67 ko'rinishida yozing"

msgid "⚠️ This doesn't look like an Uzbekistan phone number. Please send it like +998 90 123 45 67"
msgstr "⚠️ Bu O'zbekiston telefon raqamiga o'xshamaydi. Uni +998 90 123 45 67 ko'rinishida yuboring"

msgid "⚠️ Please share your contact or type your phone number."
msgstr "⚠️ Iltimos, kontaktingizni ulashing yoki telefon raqamingizni yozing."

msgid "📋 Please check your details:"
msgstr "📋 Ma'lumotlaringizni tekshiring:"

#, python-brace-format
msgid ""
"<b>Your submission</b>\n"
"\n"
"👤 Full name: {name}\n"
"📞 Phone: {phone}\n"
"\n"
"Is everything correct?"
msgstr ""
"<b>Arizangiz</b>\n"
"\n"
"👤 To'liq ism: {name}\n"
"📞 Telefon: {phone}\n"
"\n"
"Hammasi to'g'rimi?"

msgid "✅ Sent for review"
msgstr "✅ Tekshiruvga yuborildi"

msgid "✅ Thank you! Your payment has been sent for review. We'll notify you here."
msgstr "✅ Rahmat! To'lovingiz tekshiruvga yuborildi. Sizga shu yerda xabar beramiz."

