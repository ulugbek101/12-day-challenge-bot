msgstr "активна 🟢"

msgid ""
"🗂 <b>Admin panel</b>\n"
"\n"
"Choose a section:"
msgstr ""
"🗂 <b>Админ-панель</b>\n"
"\n"
"Выберите раздел:"

msgid ""
"⚙️ <b>Settings</b>\n"
"\n"
"Choose your language:"
msgstr ""
"⚙️ <b>Настройки</b>\n"
"\n"
"Выберите язык:"

msgid "⏳ <b>Pending payments</b>"
msgstr "⏳ <b>Оплаты на проверке</b>"

msgid "✅ <b>Approved clients</b>"
msgstr "✅ <b>Одобренные клиенты</b>"

msgid "❌ <b>Rejected clients</b>"
msgstr "❌ <b>Отклонённые клиенты</b>"

msgid "The list is empty."
msgstr "Список пуст."

#, python-brace-format
msgid "page {page}/{pages}"
msgstr "стр. {page}/{pages}"

msgid ""
"🔍 <b>Search</b>\n"
"\n"
"Send part of a name, a phone number (any format), an @username or an exact Telegram ID."
msgstr ""
"🔍 <b>Поиск</b>\n"
"\n"
"Отправьте часть имени, номер телефона (в любом формате), @username или точный Telegram ID."

msgid "⚠️ Please send at least 2 characters."
msgstr "⚠️ Отправьте не менее 2 символов."

#, python-brace-format
msgid "🔍 Results for “{query}”"
msgstr "🔍 Результаты по «{query}»"

