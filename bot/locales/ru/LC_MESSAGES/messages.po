#, python-brace-format
msgid "🎉 {name} joined the channel"
msgstr "🎉 {name} вступил(а) в канал"

msgid "👋 Welcome, admin!"
msgstr "👋 Добро пожаловать, администратор!"

msgid "👋 Welcome! Use the buttons below to submit your payment or change the language."
msgstr "👋 Добро пожаловать! Используйте кнопки ниже, чтобы отправить оплату или сменить язык."

msgid "✅ Language changed."
msgstr "✅ Язык изменён."

msgid "👋 Welcome! Here you can submit your payment to get access to the channel."
msgstr ""
"👋 Добро пожаловать! Здесь вы можете отправить подтверждение оплаты, чтобы получить доступ к "
"каналу."

msgid "⏳ Your payment has not been approved yet. Please wait — we'll notify you here."
msgstr "⏳ Ваша оплата ещё не подтверждена. Пожалуйста, подождите — мы сообщим вам здесь."

#, python-brace-format
msgid "⚠️ Could not create the invite link: {error}"
msgstr "⚠️ Не удалось создать ссылку-приглашение: {error}"

msgid "There is no active link. Generate a new one first."
msgstr "Активной ссылки нет. Сначала создайте новую."

msgid "📤 The link was sent to the user."
msgstr "📤 Ссылка отправлена пользователю."

#, python-brace-format
msgid "⚠️ Could not send the link: {error}"
msgstr "⚠️ Не удалось отправить ссылку: {error}"

#, python-brace-format
msgid "ℹ️ Already processed by {admin}."
msgstr "ℹ️ Уже обработано: {admin}."

msgid "Client not found."
msgstr "Клиент не найден."

msgid ""
"❌ Unfortunately, your payment was not accepted.\n"
"\n"
"Reason:"
msgstr ""
"❌ К сожалению, ваша оплата не принята.\n"
"\n"
"Причина:"

#, python-brace-format
msgid "✅ The reason was delivered to {name}."
msgstr "✅ Причина доставлена: {name}."

#, python-brace-format
msgid "⚠️ Could not deliver the reason to {name}: {error}"
msgstr "⚠️ Не удалось доставить причину ({name}): {error}"

#, python-brace-format
msgid "❌ {name} rejected."
msgstr "❌ {name}: отклонено."

msgid "⏳ Your payment is under review. We'll notify you here once it's checked."
msgstr "⏳ Ваша оплата на проверке. Мы сообщим вам здесь, как только проверим."

msgid "✅ You're already approved. Please use the personal invite link we sent you."
msgstr "✅ Ваша оплата уже подтверждена. Воспользуйтесь персональной ссылкой, которую мы вам отправили."

#, python-brace-format
msgid "Need help? Contact @{support}"
msgstr "Нужна помощь? Напишите @{support}"

msgid ""
"💳 <b>How to pay</b>\n"
"\n"
"1. Open the payment page below and pay by card transfer.\n"
"2. Take a screenshot of the successful payment.\n"
"3. Send the screenshot or receipt (photo, image file or PDF) here 👇"
msgstr ""
"💳 <b>Как оплатить</b>\n"
"\n"
"1. Откройте страницу оплаты ниже и оплатите переводом на карту.\n"
"2. Сделайте скриншот успешной оплаты.\n"
"3. Отправьте сюда скриншот или чек (фото, файл-изображение или PDF) 👇"

msgid "🌐 Choose your language:"
msgstr "🌐 Выберите язык:"

msgid "⚠️ Please send the payment screenshot or receipt as a photo, an image file or a PDF."
msgstr "⚠️ Пожалуйста, отправьте скриншот или чек оплаты как фото, файл-изображение или PDF."

msgid "✍️ Enter your full name (first and last name):"
msgstr "✍️ Введите ваше полное имя (имя и фамилию):"

msgid "⚠️ The name must be 2 to 100 characters long. Please try again:"
msgstr "⚠️ Имя должно содержать от 2 до 100 символов. Попробуйте ещё раз:"

msgid "⚠️ Please type your full name as text."
msgstr "⚠️ Пожалуйста, введите полное имя текстом."

msgid "📞 Send your phone number: tap “Share my contact” below, or type it, e.g. +998 90 123 45 67"
msgstr ""
"📞 Отправьте номер телефона: нажмите «Поделиться контактом» ниже или введите его, например +998 90"
" 123 45 67"

msgid "Or use the number from your previous attempt:"
msgstr "Или используйте номер из предыдущей попытки:"

msgid "⚠️ Please share your own contact using the button, or type your number."
msgstr "⚠️ Пожалуйста, поделитесь своим контактом с помощью кнопки или введите номер."

msgid "⚠️ Only Uzbekistan numbers are accepted. Please type a number like +998 90 123 45 67"
msgstr "⚠️ Принимаются только номера Узбекистана. Введите номер в формате +998 90 123 45 67"

msgid "⚠️ This doesn't look like an Uzbekistan phone number. Please send it like +998 90 123 45 67"
msgstr "⚠️ Это не похоже на номер телефона Узбекистана. Отправьте его в формате +998 90 123 45 67"

msgid "⚠️ Please share your contact or type your phone number."
msgstr "⚠️ Пожалуйста, поделитесь контактом или введите номер телефона."

msgid "📋 Please check your details:"
msgstr "📋 Проверьте ваши данные:"

#, python-brace-format
msgid ""
"<b>Your submission</b>\n"
"\n"
"👤 Full name: {name}\n"
"📞 Phone: {phone}\n"
"\n"
"Is everything correct?"
msgstr ""
"<b>Ваша заявка</b>\n"
"\n"
"👤 Полное имя: {name}\n"
"📞 Телефон: {phone}\n"
"\n"
"Всё верно?"

msgid "✅ Sent for review"
msgstr "✅ Отправлено на проверку"

msgid "✅ Thank you! Your payment has been sent for review. We'll notify you here."
msgstr "✅ Спасибо! Ваша оплата отправлена на проверку. Мы сообщим вам здесь."

#, python-brace-format
msgid "🆕 {name} — new payment to review"
msgstr "🆕 {name} — новая оплата на проверку"

msgid "🔄 Let's start over."
msgstr "🔄 Начнём заново."

msgid "❌ Submission cancelled."
msgstr "❌ Отправка отменена."

msgid "This form is no longer active."
msgstr "Эта форма больше не активна."

msgid "Please use the buttons under your submission: ✅ Send or 🔄 Start over."
msgstr "Пожалуйста, используйте кнопки под заявкой: ✅ Отправить или 🔄 Начать заново."

msgid "Please use the buttons below 👇"
msgstr "Пожалуйста, используйте кнопки ниже 👇"

msgid "⬅️ Back"
msgstr "⬅️ Назад"

#, python-brace-format
msgid "⏳ Pending ({n})"
msgstr "⏳ На проверке ({n})"

#, python-brace-format
msgid "✅ Approved ({n})"
msgstr "✅ Одобренные ({n})"

#, python-brace-format
msgid "❌ Rejected ({n})"
msgstr "❌ Отклонённые ({n})"

msgid "🔍 Search"
msgstr "🔍 Поиск"

