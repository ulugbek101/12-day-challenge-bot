msgstr "📤 Отправить ссылку повторно"

msgid "🔁 Retry generating link"
msgstr "🔁 Повторить создание ссылки"

msgid "✅ I'm sure"
msgstr "✅ Да, уверен(а)"

msgid "⬅️ Back to card"
msgstr "⬅️ К карточке"

msgid "🔁 Retry sending to user"
msgstr "🔁 Повторить отправку"

msgid "👤 Open card"
msgstr "👤 Открыть карточку"

msgid "Open"
msgstr "Открыть"

msgid "🔁 Retry sending"
msgstr "🔁 Повторить отправку"

msgid "💳 Submit payment"
msgstr "💳 Отправить оплату"

msgid "🗂 Admin panel"
msgstr "🗂 Админ-панель"

msgid "📱 Share my contact"
msgstr "📱 Поделиться контактом"

msgid "💳 Open payment page"
msgstr "💳 Открыть страницу оплаты"

msgid "❌ Cancel"
msgstr "❌ Отмена"

#, python-brace-format
msgid "Use: {value}"
msgstr "Использовать: {value}"

msgid "✅ Send"
msgstr "✅ Отправить"

msgid "🔄 Start over"
msgstr "🔄 Начать заново"

msgid "🔄 Submit again"
msgstr "🔄 Отправить снова"

#, python-brace-format
msgid "⌛ {name}'s link expired without joining"
msgstr "⌛ Ссылка {name} истекла, вступления не было"

#, python-brace-format
msgid ""
"🎉 Congratulations! Your payment has been approved.\n"
"\n"
"Here is your personal invite link. It works only for your Telegram account and is valid until "
"{expires}:\n"
"<pre>{link}</pre>\n"
"Open it and tap “Request to join” — the bot will let you in automatically."
msgstr ""
"🎉 Поздравляем! Ваша оплата подтверждена.\n"
"\n"
"Вот ваша персональная ссылка-приглашение. Она работает только для вашего аккаунта Telegram и "
"действует до {expires}:\n"
"<pre>{link}</pre>\n"
"Откройте её и нажмите «Подать заявку» — бот впустит вас автоматически."

msgid "⏳ Pending review"
msgstr "⏳ На проверке"

msgid "✅ Approved"
msgstr "✅ Одобрено"

msgid "❌ Rejected"
msgstr "❌ Отклонено"

msgid "⏳ Not approved yet — the invite link could not be created"
msgstr "⏳ Ещё не одобрен — не удалось создать ссылку-приглашение"

msgid "— No submissions"
msgstr "— Нет заявок"

msgid "used ✅"
msgstr "использована ✅"

msgid "revoked 🚫"
msgstr "отозвана 🚫"

msgid "expired ⌛"
msgstr "истекла ⌛"

