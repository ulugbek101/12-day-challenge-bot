# Telegram bot token from @BotFather
BOT_TOKEN=

# Comma-separated Telegram user IDs allowed into the admin panel, e.g. "123456789,987654321"
ADMINS=

# The private channel's numeric id (starts with -100), e.g. -1001234567890
CHANNEL_ID=

# MySQL connection. When using the bundled docker-compose "mysql" service, DB_HOST=mysql.
DB_HOST=mysql
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Only used by the mysql service itself (docker-compose.yml), not by the bot.
MYSQL_ROOT_PASSWORD=

# Python logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# IANA timezone used to display dates/times to users and admins (data is stored in UTC)
TZ=Asia/Tashkent

# Language shown before a client has picked one: ru or uz
DEFAULT_LANGUAGE=ru

# Page shown to clients explaining how/where to pay before they upload a screenshot
PAYMENT_PAGE_URL=https://example.com/payment

# Optional @username shown to approved clients who need help ("" to hide it)
SUPPORT_USERNAME=

# How long a personal invite link stays valid before it expires unused
INVITE_LINK_TTL_HOURS=24

